# Datenbank (lokal via docker-compose.yml im Root, oder eigene Instanz)
DATABASE_URL=postgresql://travel:dev_changeme@localhost:5432/traveldb

# JWT — in Produktion durch langen Zufallsstring ersetzen
JWT_SECRET=dev-secret-change-in-production

# Server-Port
PORT=3000

# CORS-Ursprünge (Standard passt zum lokalen Setup)
APP_ORIGIN=http://localhost:3001
SITE_ORIGIN=http://localhost:3002

# Upload-Pfad (relativ zum backend/-Verzeichnis)
STORAGE_PATH=./uploads

# Owner-Account für `npm run db:seed`
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
