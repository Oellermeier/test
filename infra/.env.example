# Datenbank
POSTGRES_USER=travel
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=traveldb
DATABASE_URL=postgresql://travel:changeme_in_production@localhost:5432/traveldb

# Auth (NextAuth.js)
# Generieren: openssl rand -base64 32
NEXTAUTH_SECRET=your_secret_here
NEXTAUTH_URL=http://localhost:3000

# Owner-Account (wird beim ersten Start erstellt)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=changeme_in_production

# API URLs
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Medienspeicher (MVP: lokal)
STORAGE_PATH=./uploads
# Später: S3-kompatibel
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
