---
import BaseLayout from '@/layouts/BaseLayout.astro'
import MediaGallery from '@/components/MediaGallery.astro'
import { apiFetch } from '@/lib/api'
import { familyHeaders } from '@/lib/viewer-auth'
import { formatDateLong } from '@/lib/format'
import type { DayDetail, TripDetail } from '@/types/api'

const { id, dayId } = Astro.params
const authHeaders = familyHeaders(Astro.cookies)

const [day, trip] = await Promise.all([
  apiFetch<DayDetail>(`/days/${dayId}`, authHeaders),
  apiFetch<TripDetail>(`/trips/${id}`, authHeaders),
])

if (!day || !trip) return Astro.redirect(`/reisen/${id}`, 302)

const images   = day.media.filter(m => m.type === 'IMAGE')
const docs     = day.media.filter(m => m.type === 'DOCUMENT' || m.type === 'GPX')
---

<BaseLayout title={day.title ?? formatDateLong(day.date)} description={day.summary ?? undefined}>

  <!-- Breadcrumb -->
  <nav class="text-xs font-sans text-stone-400 mb-6 flex flex-wrap gap-1 items-center">
    <a href="/reisen" class="hover:text-stone-700 transition-colors">Alle Reisen</a>
    <span>/</span>
    <a href={`/reisen/${id}`} class="hover:text-stone-700 transition-colors">{trip.title}</a>
    <span>/</span>
    <span class="text-stone-600">{formatDateLong(day.date)}</span>
  </nav>

  <!-- Day Header -->
  <header class="mb-10">
    <p class="text-sm font-sans font-medium text-amber-700 uppercase tracking-wider mb-2">
      {formatDateLong(day.date)}
      {day.stage && <span class="text-stone-400"> · {day.stage.title}</span>}
    </p>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-snug mb-3">
      {day.title ?? formatDateLong(day.date)}
    </h1>
    {day.summary && (
      <p class="text-lg text-stone-500 font-sans leading-relaxed max-w-2xl">{day.summary}</p>
    )}
  </header>

  <!-- Notizen (Haupttext) -->
  {day.notes.length > 0 && (
    <section class="mb-10 space-y-5 max-w-2xl">
      {day.notes.map(note => (
        <p class="leading-8 text-stone-700 whitespace-pre-line">{note.content}</p>
      ))}
    </section>
  )}

  <!-- Bilder -->
  {images.length > 0 && (
    <section class="mb-10">
      <MediaGallery images={images} />
    </section>
  )}

  <!-- Orte -->
  {day.locations.length > 0 && (
    <section class="mb-10">
      <h2 class="text-xs font-sans font-semibold uppercase tracking-widest text-stone-400 mb-3">Orte</h2>
      <ul class="flex flex-wrap gap-2">
        {day.locations.map(loc => (
          <li>
            {loc.lat && loc.lon ? (
              <a
                href={`https://maps.google.com/?q=${loc.lat},${loc.lon}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-sm font-sans px-3 py-1.5 rounded-full border border-stone-200 bg-white hover:border-amber-300 hover:text-amber-800 transition-colors"
              >
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                  <circle cx="12" cy="9" r="2.5"/>
                </svg>
                {loc.name}
              </a>
            ) : (
              <span class="inline-flex items-center gap-1.5 text-sm font-sans px-3 py-1.5 rounded-full border border-stone-200 bg-white text-stone-600">
                {loc.name}
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Dokumente & GPX -->
  {docs.length > 0 && (
    <section class="mb-10">
      <h2 class="text-xs font-sans font-semibold uppercase tracking-widest text-stone-400 mb-3">Dateien</h2>
      <ul class="space-y-2">
        {docs.map(doc => (
          <li>
            <a
              href={`/api/media-proxy?url=${encodeURIComponent(doc.storageUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-sans text-amber-800 hover:underline"
            >
              <svg class="w-4 h-4 shrink-0 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke-linejoin="round"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
              {doc.filename}
              <span class="text-stone-400 text-xs uppercase">{doc.type}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Navigation (Prev/Next innerhalb der Reise) -->
  <nav class="mt-12 pt-6 border-t border-stone-200">
    <a href={`/reisen/${id}`} class="text-sm font-sans text-stone-500 hover:text-stone-900 transition-colors">
      ← Zurück zur Reise
    </a>
  </nav>

</BaseLayout>
