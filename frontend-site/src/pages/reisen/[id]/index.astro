---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { apiFetch } from '@/lib/api'
import { familyHeaders } from '@/lib/viewer-auth'
import { formatDateRange, formatDateLong } from '@/lib/format'
import type { TripDetail, DayListItem } from '@/types/api'

const { id } = Astro.params
const trip = await apiFetch<TripDetail>(`/trips/${id}`, familyHeaders(Astro.cookies))
if (!trip) return Astro.redirect('/reisen', 302)

const dateRange = formatDateRange(trip.startDate, trip.endDate)

// Tage nach Etappe gruppieren (falls vorhanden)
const stageMap = new Map(trip.stages.map(s => [s.id, s.title]))
---

<BaseLayout title={trip.title} description={trip.description ?? undefined}>

  <!-- Breadcrumb -->
  <nav class="text-xs font-sans text-stone-400 mb-6">
    <a href="/reisen" class="hover:text-stone-700 transition-colors">Alle Reisen</a>
    <span class="mx-2">/</span>
    <span class="text-stone-600">{trip.title}</span>
  </nav>

  <!-- Trip Header -->
  <header class="mb-10 pb-8 border-b border-stone-200">
    <p class="text-sm font-sans font-medium text-amber-700 uppercase tracking-wider mb-2">
      {dateRange}
    </p>
    <h1 class="text-4xl font-bold tracking-tight mb-3">{trip.title}</h1>
    {trip.description && (
      <p class="text-lg text-stone-500 font-sans leading-relaxed max-w-2xl">{trip.description}</p>
    )}
  </header>

  <!-- Etappen-Chips (nur wenn vorhanden) -->
  {trip.stages.length > 0 && (
    <div class="mb-8 flex flex-wrap gap-2">
      {trip.stages.map(stage => (
        <span class="text-xs font-sans px-3 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200">
          {stage.title}
        </span>
      ))}
    </div>
  )}

  <!-- Tagesliste -->
  {trip.days.length === 0 ? (
    <p class="text-stone-400 font-sans text-sm py-12 text-center">Noch keine Tage veröffentlicht.</p>
  ) : (
    <ol class="space-y-3">
      {trip.days.map((day: DayListItem) => (
        <li>
          <a
            href={`/reisen/${trip.id}/tage/${day.id}`}
            class="group flex gap-5 items-start p-4 rounded-xl bg-white border border-stone-200 hover:shadow-sm hover:border-amber-200 transition-all"
          >
            <div class="shrink-0 text-right min-w-[3.5rem]">
              <span class="text-xs font-sans text-stone-400 block">{formatDateLong(day.date).split('.')[0] + '.'}</span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-stone-800 group-hover:text-amber-800 transition-colors truncate">
                {day.title ?? formatDateLong(day.date)}
              </p>
              {day.summary && (
                <p class="text-sm text-stone-500 font-sans mt-0.5 line-clamp-1">{day.summary}</p>
              )}
              {(day._count.media > 0 || day.stageId) && (
                <div class="flex gap-3 mt-1.5 text-xs font-sans text-stone-400">
                  {day.stageId && stageMap.has(day.stageId) && (
                    <span>{stageMap.get(day.stageId)}</span>
                  )}
                  {day._count.media > 0 && (
                    <span>{day._count.media} {day._count.media === 1 ? 'Medium' : 'Medien'}</span>
                  )}
                </div>
              )}
            </div>
            <svg class="shrink-0 w-4 h-4 text-stone-300 group-hover:text-amber-400 transition-colors mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </li>
      ))}
    </ol>
  )}

</BaseLayout>
