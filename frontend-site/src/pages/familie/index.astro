---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { isFamilyMember } from '@/lib/viewer-auth'

// Logout
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const action = form.get('action')

  if (action === 'logout') {
    Astro.cookies.delete('family_ok', { path: '/' })
    return Astro.redirect('/familie', 302)
  }

  if (action === 'login') {
    const password = form.get('password')?.toString() ?? ''
    const correct  = import.meta.env.FAMILY_PASSWORD
    if (correct && password === correct) {
      Astro.cookies.set('family_ok', '1', {
        path:     '/',
        httpOnly: true,
        secure:   import.meta.env.PROD,
        maxAge:   60 * 60 * 24 * 30,
        sameSite: 'lax',
      })
      return Astro.redirect('/reisen', 302)
    }
  }
}

const isFamily = isFamilyMember(Astro.cookies)
const loginError = Astro.request.method === 'POST'
---

<BaseLayout title="Familienbereich" description="Geschützter Zugang für Familienmitglieder">

  <div class="max-w-sm mx-auto pt-10">
    <h1 class="text-2xl font-bold mb-2">Familienbereich</h1>
    <p class="text-stone-500 font-sans text-sm mb-8">
      Familienmitglieder können hier geschützte Reiseinhalte einsehen.
    </p>

    {isFamily ? (
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5">
        <p class="text-sm font-sans text-amber-900 mb-4">
          Du bist als Familienmitglied eingeloggt.
        </p>
        <form method="POST">
          <input type="hidden" name="action" value="logout" />
          <button
            type="submit"
            class="text-sm font-sans px-4 py-2 rounded-lg border border-stone-300 text-stone-700 hover:bg-stone-100 transition-colors"
          >
            Abmelden
          </button>
        </form>
      </div>
    ) : (
      <form method="POST" class="space-y-4">
        <input type="hidden" name="action" value="login" />
        <div>
          <label class="block text-sm font-sans font-medium text-stone-700 mb-1.5" for="password">
            Passwort
          </label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm font-sans focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent"
            placeholder="Familienpasswort eingeben"
          />
        </div>
        {loginError && (
          <p class="text-sm text-red-600 font-sans">Falsches Passwort.</p>
        )}
        <button
          type="submit"
          class="w-full bg-amber-700 text-white font-sans font-medium text-sm rounded-lg px-4 py-2.5 hover:bg-amber-800 transition-colors"
        >
          Einloggen
        </button>
      </form>
    )}
  </div>

</BaseLayout>
