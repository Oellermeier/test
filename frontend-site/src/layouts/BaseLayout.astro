---
interface Props {
  title:       string
  description?: string
}
const { title, description = 'Reiseberichte und Abenteuer' } = Astro.props
---
<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Auf Reisen</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 font-serif antialiased">

    <!-- Header -->
    <header class="border-b border-stone-200 bg-white/90 backdrop-blur-sm sticky top-0 z-10">
      <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/reisen" class="text-xl font-bold tracking-tight hover:text-amber-700 transition-colors">
          Auf Reisen
        </a>
        <nav class="text-sm text-stone-500 space-x-5 font-sans">
          <a href="/reisen" class="hover:text-stone-900 transition-colors">Alle Reisen</a>
        </nav>
      </div>
    </header>

    <!-- Content -->
    <main class="max-w-4xl mx-auto px-4 py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-200 mt-20 py-8 text-center text-xs text-stone-400 font-sans">
      Auf Reisen &mdash; persönliche Reiseberichte
    </footer>

  </body>
</html>
