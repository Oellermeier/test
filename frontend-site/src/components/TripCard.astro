---
import { formatDateRange } from '@/lib/format'
import type { TripListItem } from '@/types/api'

interface Props {
  trip: TripListItem
}
const { trip } = Astro.props
const dateRange = formatDateRange(trip.startDate, trip.endDate)
const dayCount  = trip._count.days
---

<a
  href={`/reisen/${trip.id}`}
  class="group block rounded-2xl overflow-hidden bg-white border border-stone-200 shadow-sm hover:shadow-md transition-shadow"
>
  <!-- Cover / Placeholder -->
  {trip.coverImage ? (
    <div class="aspect-[16/7] overflow-hidden bg-stone-100">
      <img
        src={trip.coverImage}
        alt={trip.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="aspect-[16/7] bg-gradient-to-br from-amber-50 to-stone-100 flex items-center justify-center">
      <svg class="w-10 h-10 text-stone-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3.75 7.5l16.5-3M3.75 12l16.5-1.5M3.75 16.5l16.5 1.5" stroke-linecap="round" />
      </svg>
    </div>
  )}

  <!-- Content -->
  <div class="p-5">
    <p class="text-xs font-sans font-medium text-amber-700 uppercase tracking-wider mb-1">
      {dateRange}
    </p>
    <h2 class="text-xl font-bold leading-snug mb-2 group-hover:text-amber-800 transition-colors">
      {trip.title}
    </h2>
    {trip.description && (
      <p class="text-sm text-stone-600 line-clamp-2 font-sans leading-relaxed">
        {trip.description}
      </p>
    )}
    <div class="mt-4 flex items-center gap-1 text-xs font-sans text-stone-400">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      {dayCount} {dayCount === 1 ? 'Tag' : 'Tage'}
    </div>
  </div>
</a>
