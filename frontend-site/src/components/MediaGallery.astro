---
import { mediaUrl } from '@/lib/media'
import type { MediaItem } from '@/types/api'

interface Props {
  images: MediaItem[]
}
const { images } = Astro.props
---

<div class={`grid gap-2 ${images.length === 1 ? 'grid-cols-1' : images.length === 2 ? 'grid-cols-2' : 'grid-cols-2 sm:grid-cols-3'}`}>
  {images.map(img => (
    <a
      href={mediaUrl(img.storageUrl)}
      target="_blank"
      rel="noopener noreferrer"
      class="block overflow-hidden rounded-xl bg-stone-100 aspect-square"
    >
      <img
        src={mediaUrl(img.thumbnailUrl ?? img.storageUrl)}
        alt={img.filename}
        loading="lazy"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
      />
    </a>
  ))}
</div>
