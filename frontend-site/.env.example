# Backend API (direkt, kein Proxy notwendig)
API_URL=http://localhost:3001

# Familienbereich — gemeinsames Passwort für alle Familienmitglieder
FAMILY_PASSWORD=geheim

# Langlebiger Backend-JWT mit Rolle FAMILY_EXTENDED (einmalig generieren)
# z.B.: curl -X POST http://localhost:3001/auth/login -d '{"email":"...","password":"..."}' → token kopieren
# Oder: npx ts-node scripts/generate-family-jwt.ts
FAMILY_JWT=
